{
  "name": "devdock",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode devdb",
    "dev:live": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "perf": "node scripts/check-performance.mjs",
    "check": "npm run lint && npm run build && npm run perf",
    "test:ai": "deno test --allow-env --allow-net --allow-read supabase/functions/ai-agent/tests/",
    "test:idle": "deno test tests/inactivity.test.ts tests/auth-storage.test.ts",
    "test:reminders": "TZ=America/Chicago deno test tests/reminders-when.test.ts tests/time-of-day.test.ts",
    "test:mermaid": "deno test --allow-read tests/mermaid.test.ts",
    "test:emails": "deno test --allow-env supabase/functions/send-emails/templates.test.ts",
    "test:import": "deno test tests/issue-import.test.ts",
    "test:errors": "deno test supabase/functions/_shared/error-tracking/",
    "test:feeds": "deno test supabase/functions/_shared/chat-feeds/",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/database.types.ts",
    "seed:dev": "DEV_SUPABASE_SECRET_KEY=\"$(security find-generic-password -s 'DevDock Dev secret key' -w)\" DEV_ADMIN_PASSWORD=\"$(security find-generic-password -s 'DevDock Dev admin' -w)\" DEV_MEMBER_PASSWORD=\"$(security find-generic-password -s 'DevDock Dev member' -w)\" node --experimental-websocket scripts/seed-dev.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@jitsi/react-sdk": "^1.4.4",
    "@supabase/supabase-js": "^2.109.0",
    "@tanstack/react-query": "^5.103.2",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-collaboration": "^3.31.3",
    "@tiptap/extension-drag-handle": "^3.31.3",
    "@tiptap/extension-drag-handle-react": "^3.31.3",
    "@tiptap/extension-file-handler": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-node-range": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-unique-id": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/y-tiptap": "^3.0.9",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.48.0",
    "perfect-freehand": "1.2.2",
    "posthog-js": "^1.442.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
